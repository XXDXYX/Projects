<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BookReader.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="BookReader.Views.BookReaderView"
             x:DataType="vm:BookReaderViewModel">

    <Grid Background="#444444"
          RowDefinitions="Auto,*">

        <!-- Верхняя панель -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="30,25,30,20">

            <StackPanel>
                <TextBlock Text="{Binding Book.Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F6F3FF"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding Book.Author}"
                           FontSize="14"
                           Foreground="#AAA9BD"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Width="44"
                    Height="44"
                    CornerRadius="22"
                    Background="#6D63A3"
                    VerticalAlignment="Center">
                <TextBlock Text="📖"
                           FontSize="21"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

    
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <Border MaxWidth="900"
                    HorizontalAlignment="Center"
                    Margin="30,0,30,35"
                    Padding="48,42"
                    Background="#26283A"
                    CornerRadius="14"
                    BoxShadow="0 8 20 0 #55000000">

                <StackPanel>

                   
                    <TextBlock Text="{Binding Book.Title}"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#F6F3FF"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,6" />

                    <TextBlock Text="{Binding Book.Author}"
                               FontSize="15"
                               Foreground="#AAA9BD"
                               TextAlignment="Center"
                               Margin="0,0,0,32" />

                   
                    <ItemsControl x:CompileBindings="False"
                                  ItemsSource="{Binding Book.Content}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#504D68"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,26,0,14"
                                        Margin="0,8,0,0">
                                    <ItemsControl x:CompileBindings="False"
                                                  ItemsSource="{Binding Paragraphs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ContentBlock">
                                                <StackPanel Margin="0,0,0,16"
                                                            Spacing="8">
                                                    <TextBlock Text="{Binding Text}"
                                                               IsVisible="{Binding Type,
                                                                   Converter={x:Static ObjectConverters.Equal},
                                                                   ConverterParameter={x:Static vm:ChapterType.Text}}"
                                                               FontFamily="Georgia"
                                                               FontSize="17"
                                                               LineHeight="28"
                                                               Foreground="#E8E5F0"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Justify">
                                                    </TextBlock>

                                                    <Image Source="{Binding Image}"
                                                           IsVisible="{Binding Type,
                                                               Converter={x:Static ObjectConverters.Equal},
                                                               ConverterParameter={x:Static vm:ChapterType.Image}}"
                                                           MaxHeight="600"
                                                           Stretch="Uniform">
                                                    </Image>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
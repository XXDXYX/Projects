<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:BookReader.Views"
             xmlns:viewModels="clr-namespace:BookReader.ViewModels"
             x:Class="BookReader.Views.LibraryView"
             x:DataType="viewModels:LibraryViewModel">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Books"
                   FontSize="24"
                   Margin="65,60,0,20" />

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Library}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:BookDetailsView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
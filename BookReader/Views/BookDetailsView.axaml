<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bookReader="clr-namespace:BookReader"
             xmlns:local="clr-namespace:BookReader.ViewModels"
             x:Class="BookReader.Views.BookDetailsView"
             x:DataType="local:BookDetailsView">
            <Border Width="160" Height="260" Margin="15" Background="#444444">
                <Grid RowDefinitions="180,*,Auto">
                    
                    
                    <Border Grid.Row = "0" 
                            
                           Background="#4C4C4C">
                        <Image Source="{Binding Image}" Margin="3" Stretch="UniformToFill" />
                    </Border>
                    
                    <TextBlock Grid.Row="1" Text="{Binding Title}"  TextTrimming="CharacterEllipsis" MaxLines="2"
                               Margin="5,5,5,0" FontSize="14" TextWrapping="Wrap" FontWeight="Bold" TextAlignment="Center"
                               ></TextBlock>
                    <TextBlock Grid.Row="2" Text = "{Binding Author}" Margin="0,0,0,10" FontSize="12" TextAlignment="Center"
                               ></TextBlock>
                    
                </Grid>
                
            </Border>
    
    
    
    
   
</UserControl>
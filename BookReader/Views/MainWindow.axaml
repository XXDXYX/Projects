<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BookReader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BookReader.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BookReader"
        Background="#444444">
        <Grid ColumnDefinitions="50,*" >
            <Border Grid.Column="1" Background="#979394" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="0" RowDefinitions="50,50,50,*">
                                                         
              </Grid> 
             <Border Grid.Column="0" Background="#535353"></Border>
            <Border Grid.Column="1" Background="#444444"/>
            <TextBlock Grid.Column="1" Text="Books" Margin="65,60,0,0" FontSize="24"/>
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,70,0" Content="+ Add books"
                    Background="#D04ADB"
                    > </Button>
                
        </Grid>
        
        
</Window>

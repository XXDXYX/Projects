<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TodoList.ViewModels"
             xmlns:todoList="clr-namespace:TodoList"
             x:Class="TodoList.Views.NoteCardView"
             x:DataType="todoList:NoteModelView">

    <UserControl.Styles>

        <!-- Карточка. Все значения, которые меняются, заданы стилями, а не атрибутами -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #12000000"/>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #1F3B82F6"/>
        </Style>

        <!-- Закреплённая карточка: голубоватый фон и синяя рамка -->
        <Style Selector="Border.card.pinned">
            <Setter Property="Background" Value="#F5F9FF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #1A3B82F6"/>
        </Style>
        <Style Selector="Border.card.pinned:pointerover">
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #263B82F6"/>
        </Style>

        <!-- Акцентная полоска слева -->
        <Style Selector="Border.accent">
            <Setter Property="Background" Value="#BFDBFE"/>
        </Style>
        <Style Selector="Border.card:pointerover Border.accent">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>
        <Style Selector="Border.card.pinned Border.accent">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>
        <Style Selector="Border.card.pinned:pointerover Border.accent">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <!-- Базовый стиль круглой иконки-кнопки.
             Кнопки приглушены, пока курсор не над карточкой -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover Button.icon">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.icon:focus-visible">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>

        <!-- Кнопка "Закрепить" -->
        <Style Selector="Button.pin">
            <Setter Property="ToolTip.Tip" Value="Закрепить"/>
        </Style>
        <Style Selector="Button.pin PathIcon">
            <Setter Property="RenderTransform" Value="rotate(45deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EFF6FF"/>
        </Style>
        <Style Selector="Button.pin:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DBEAFE"/>
        </Style>
        <Style Selector="Button.pin:pointerover PathIcon">
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>

        <!-- Кнопка "Закрепить" в закреплённом состоянии: всегда яркая, иконка прямая -->
        <Style Selector="Button.pin.pinned">
            <Setter Property="ToolTip.Tip" Value="Открепить"/>
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.pin.pinned PathIcon">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>
        <Style Selector="Button.pin.pinned:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#BFDBFE"/>
        </Style>

        <!-- Кнопка "Удалить" -->
        <Style Selector="Button.delete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FEF2F2"/>
        </Style>
        <Style Selector="Button.delete:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FEE2E2"/>
        </Style>
        <Style Selector="Button.delete:pointerover PathIcon">
            <Setter Property="Foreground" Value="#DC2626"/>
        </Style>

    </UserControl.Styles>

    <Border Classes="card"
            Classes.pinned="{Binding isTaskPin}"
            CornerRadius="12"
            BorderThickness="1"
            Margin="4,6">

        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
            </Transitions>
        </Border.Transitions>

        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="56">

            <!-- Акцентная полоска -->
            <Border Grid.Column="0"
                    Classes="accent"
                    Width="4"
                    CornerRadius="2"
                    Margin="12,12,0,12">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!-- Текст заметки -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Content}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="#1F2937"
                       FontSize="15"
                       LineHeight="22"
                       Margin="14,12,8,12"/>

            <!-- Кнопки действий -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">

                <Button Classes="icon pin"
                        Classes.pinned="{Binding isTaskPin}"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PinNoteCommand}"
                        CommandParameter="{Binding}">
                    <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"/>
                </Button>

                <Button Classes="icon delete"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteNoteCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Удалить">
                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                </Button>

            </StackPanel>
        </Grid>
    </Border>

</UserControl>